# TouchGrass Environment Configuration
PORT=3001

# Gemma API Configuration
# By default, TouchGrass connects to any standard Gemma provider:
# (Google AI Studio, Groq, OpenRouter, Hugging Face, or local Ollama / vLLM)
GEMMA_API_KEY=

# Primary Gemma model name (e.g., gemma-2-9b-it, gemma-2-27b-it, gemma2-9b-it)
GEMMA_MODEL=gemma-2-9b-it

# Vision-capable Gemma model (e.g., paligemma-3b-mix-448, gemma-3-12b-it, or compatible vision endpoint)
GEMMA_VISION_MODEL=paligemma-3b-mix-448

# Base URL for the Gemma provider (defaults to Google AI / standard OpenAI-compatible API)
# Examples:
# OpenRouter: https://openrouter.ai/api/v1
# Groq: https://api.groq.com/openai/v1
# Local Ollama: http://localhost:11434/v1
GEMMA_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Fallback mode note:
# If GEMMA_API_KEY is left empty, the application automatically uses MockGemmaProvider
# which supplies rich, whimsical outdoor adventures for local development.
